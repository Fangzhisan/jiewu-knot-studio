{
  "name": "jiewu-knot-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5187 --strictPort",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"scripts/*.mjs\" vite.config.ts tsconfig.json package.json index.html \"public/*.svg\" .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"scripts/*.mjs\" vite.config.ts tsconfig.json package.json index.html \"public/*.svg\" .prettierrc.json",
    "build": "npm run check:projections && vue-tsc --noEmit && vite build",
    "generate:projections": "node scripts/generate-course-projections.mjs",
    "check:projections": "node scripts/generate-course-projections.mjs --check",
    "check:courses": "node scripts/check-courses.mjs",
    "check:knot-atlas": "node scripts/check-knot-atlas.mjs",
    "check:knot-geometry": "node scripts/check-knot-geometry.mjs",
    "export:knot-benchmark": "node scripts/export-knot-benchmark.mjs",
    "check:end-labels": "node scripts/check-end-labels.mjs",
    "check:bead-caps": "node scripts/check-bead-caps.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5187 --strictPort",
    "check:weaving-atlas": "node scripts/check-weaving-atlas.mjs",
    "export:weaving-curriculum": "node scripts/export-weaving-curriculum.mjs",
    "check:bead-projects": "node scripts/check-bead-projects.mjs",
    "check:bead-atlas": "node scripts/check-bead-atlas.mjs",
    "export:bead-curriculum": "node scripts/export-bead-curriculum.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.61.0",
    "three": "0.186.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  },
  "description": "结物 🪢 一个学绳结、编织和串珠的小站。",
  "license": "MIT",
  "author": "Fangzhisan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fangzhisan/jiewu-knot-studio.git"
  }
}
